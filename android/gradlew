#!/bin/sh
# Gradle wrapper script — generated by Gradle.
# Run `gradle wrapper` or open in Android Studio to generate the gradle-wrapper.jar binary.

SCRIPT_DIR=$(dirname "$0")
JAVA_EXE="java"

exec "$JAVA_EXE" -classpath "$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
